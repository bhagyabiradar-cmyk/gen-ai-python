
print("🤖 Welcome to AI Study Buddy!")

topics = {
    "python": "Python is a programming language used in AI and Data Science.",
    "sql": "SQL is used to store, retrieve, and manage database information.",
    "data science": "Data Science uses data, statistics, and programming to find insights.",
    "machine learning": "Machine Learning enables computers to learn patterns from data.",
    "genai": "Generative AI creates new content, such as text, images, and code."
}

while True:
    question = input("\nAsk me a topic (or type exit): ").lower()

    if question == "exit":
        print("Keep learning! Goodbye 👋")
        break

    answer = False

    for topic, explanation in topics.items():
        if topic in question:
            print("🤖 AI Buddy:", explanation)
            answer = True
            break

    if not answer:
        print("🤖 AI Buddy: Try Python, SQL, Data Science, ML, or GenAI.")
