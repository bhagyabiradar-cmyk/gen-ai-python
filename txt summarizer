import streamlit as st
import re

st.set_page_config(page_title="TextSnap AI")

st.title("🧠 TextSnap AI")
st.subheader("Smart Text Summarizer")

text = st.text_area(
    "Enter your paragraph here:",
    height=200
)

summary_length = st.slider(
    "Number of sentences in summary",
    min_value=1,
    max_value=5,
    value=2
)

if st.button("Generate Summary"):
    if text.strip():
        sentences = re.split(r'(?<=[.!?])\s+', text.strip())

        words = re.findall(r'\b[a-zA-Z]+\b', text.lower())

        stop_words = {
            "the", "is", "a", "an", "and", "or", "to",
            "of", "in", "on", "for", "with", "it", "this",
            "that", "are", "was", "were", "be", "as"
        }

        frequency = {}

        for word in words:
            if word not in stop_words:
                frequency[word] = frequency.get(word, 0) + 1

        scored_sentences = []

        for index, sentence in enumerate(sentences):
            sentence_words = re.findall(
                r'\b[a-zA-Z]+\b',
                sentence.lower()
            )

            score = sum(
                frequency.get(word, 0)
                for word in sentence_words
            )

            scored_sentences.append((index, score, sentence))

        top_sentences = sorted(
            scored_sentences,
            key=lambda item: item[1],
            reverse=True
        )[:summary_length]

        top_sentences.sort(key=lambda item: item[0])

        summary = " ".join(
            sentence for _, _, sentence in top_sentences
        )

        st.subheader("📝 Your Summary")
        st.write(summary)

        original_words = len(text.split())
        summary_words = len(summary.split())

        st.write(f"Original word count: {original_words}")
        st.write(f"Summary word count: {summary_words}")

        if original_words:
            reduction = (
                (original_words - summary_words)
                / original_words
            ) * 100

            st.write(
                f"Text reduction: {reduction:.1f}%"
            )

    else:
        st.warning("Please enter some text first.")